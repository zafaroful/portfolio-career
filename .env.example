# Database
#
# Local (Docker / prisma dev):
# DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio_career?schema=public"
# DIRECT_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio_career?schema=public"
#
# Supabase (Project Settings → Database → Connect):
#   DATABASE_URL — Transaction pooler, port 6543, append ?pgbouncer=true
#   DIRECT_URL   — Session pooler (port 5432) or Direct connection (db.<ref>.supabase.co)
#
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio_career?schema=public"
DIRECT_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio_career?schema=public"

# Auth.js
AUTH_SECRET="change-me-in-production-use-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Admin seed (used by prisma/seed.ts)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme123"
ADMIN_NAME="Portfolio Admin"
ADMIN_PORTFOLIO_SLUG="admin"

# Cloudflare R2 (optional — Vercel Blob or local uploads/ folder used as fallback)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="portfolio-career"
R2_PUBLIC_URL=""
R2_ENDPOINT=""

# Vercel Blob (auto-set on Vercel when a Blob store is linked to the project)
BLOB_READ_WRITE_TOKEN=""

# AI (OpenAI)
OPENAI_API_KEY=""
AI_MODEL="gpt-4o"

# Rate limiting (optional — Upstash Redis)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sentry (optional)
SENTRY_DSN=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
